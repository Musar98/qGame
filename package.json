{
  "name": "qgame",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:headless": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "format": "prettier --write \"src/**/*.{html,css,ts}\" \"tests/**/*.ts\" \"package.json\" \"README.md\" \"tsconfig*.json\" \"angular.json\"",
    "format:check": "prettier --check \"src/**/*.{html,css,ts}\" \"tests/**/*.ts\" \"package.json\" \"README.md\" \"tsconfig*.json\" \"angular.json\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/platform-browser-dynamic": "^22.2.2",
    "@angular/router": "^22.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@vitest/coverage-v8": "^5.0.4",
    "baseline-browser-mapping": "^2.11.28",
    "jsdom": "^30.1.2",
    "prettier": "^3.2.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
